# A-Share Research OS configuration (copy to .env and adjust)
# Backend settings use the ASRO_ prefix (see backend/app/config.py).

# Database. Development default is a local SQLite file; production target is
# PostgreSQL — point this at your managed instance.
ASRO_DATABASE_URL=sqlite:///./data/asro.db
# ASRO_DATABASE_URL=postgresql+psycopg://user:password@db:5432/asro

# CORS origins allowed to call the API (JSON list). Public deployments MUST
# restrict this to the actual frontend origin.
ASRO_CORS_ORIGINS=["http://localhost:8080"]

# Debug mode (never enable in production)
ASRO_DEBUG=false
